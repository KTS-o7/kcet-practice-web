[Unit]
Description=KCET practice (kcet.shenthar.me)
After=network.target

[Service]
User=deploy
Group=deploy
WorkingDirectory=/opt/kcet
EnvironmentFile=/opt/kcet/.env
Environment=TZ=Asia/Kolkata
Environment=GOMEMLIMIT=200MiB
ExecStart=/opt/kcet/kcet -addr 127.0.0.1:8093 -db /opt/kcet/data/kcet.db
Restart=on-failure
RestartSec=2
MemoryMax=384M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/kcet/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
